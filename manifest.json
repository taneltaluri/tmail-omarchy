{
  "schemaVersion": 1,
  "id": "io.github.taneltaluri.tmail",
  "name": "TMail",
  "version": "1.1.0",
  "author": "Tanel Taluri",
  "license": "MIT",
  "description": "Unread mail counter for the Omarchy bar with a popup of your latest messages. Talks to the TMail desktop client running on this machine.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "TMail",
    "description": "Unread count and recent messages by account, with quick mark-read and move-to-Trash actions",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "port": 8765,
      "interval": 30,
      "showZero": true,
      "launchCommand": "tmail"
    },
    "schema": [
      {
        "key": "port",
        "type": "number",
        "label": "TMail local port"
      },
      {
        "key": "interval",
        "type": "number",
        "label": "Refresh every (seconds)"
      },
      {
        "key": "showZero",
        "type": "boolean",
        "label": "Show icon when there is no unread mail"
      },
      {
        "key": "launchCommand",
        "type": "string",
        "label": "Command to launch TMail"
      }
    ]
  }
}
