# Maintainer: Tanel Taluri
pkgname=tmail-bin
pkgver=2.13.1
pkgrel=1
pkgdesc="Apple Mail style email client with local AI (MCP) access"
arch=('x86_64')
url="https://sharks.pw/tmail/dist"
license=('MIT')
depends=('gtk3' 'nss' 'alsa-lib' 'libxss' 'libnotify' 'at-spi2-core' 'libxkbcommon' 'mesa')
optdepends=('libayatana-appindicator: tray icon in waybar/Hyprland'
            'gnome-keyring: encrypted password storage (safeStorage)')
provides=('tmail')
conflicts=('tmail')
options=('!strip')
source=("https://sharks.pw/tmail/dist/TMail-2.13.1-linux-x64.tar.gz")
sha256sums=('5e86edbdeb94bdceca41c620c248548517dd8ca4b6736c80ee26c2d101dd4441')

package() {
  install -d "$pkgdir/opt/tmail"
  cp -a "$srcdir/TMail-linux-x64/." "$pkgdir/opt/tmail/"
  rm -f "$pkgdir/opt/tmail/install.sh"
  chmod 4755 "$pkgdir/opt/tmail/chrome-sandbox"
  install -Dm644 "$srcdir/TMail-linux-x64/tmail.desktop" "$pkgdir/usr/share/applications/tmail.desktop"
  install -Dm644 "$srcdir/TMail-linux-x64/tmail.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/tmail.png"
  install -d "$pkgdir/usr/bin"
  ln -s /opt/tmail/tmail "$pkgdir/usr/bin/tmail"
}
